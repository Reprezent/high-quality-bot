# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: register slash commands in a single guild for near-instant updates.
# Leave empty to register commands globally across all guilds.
DISCORD_GUILD_ID=

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=botuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=highqualitybot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# Wowsims async API base URL used by the bot
WOWSIMS_API_BASE_URL=http://127.0.0.1:3333

# Log the canonical outgoing simulator request for UI/server parity diagnostics.
LOG_SIM_REQUEST_JSON=false

# Diagnostic override only. Leave false for UI-equivalent simulations.
WOWSIMS_SIM_DEBUG=false

# Warcraft Logs API v2 client credentials from
# https://www.warcraftlogs.com/api/clients/
# The same credentials are sent only to the selected Retail or Classic WCL host.
# Leave both empty to disable Warcraft Logs tracking commands and polling.
WARCRAFT_LOGS_CLIENT_ID=
WARCRAFT_LOGS_CLIENT_SECRET=

# Optional Warcraft Logs polling interval. Values below 30 seconds are clamped to 30.
WARCRAFT_LOGS_POLL_INTERVAL_SECS=60
